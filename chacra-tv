<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chacra TV | Grilla de Programación en Vivo</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
                        display: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        chacra: {
                            dark: '#1B4332',
                            primary: '#2D6A4F',
                            light: '#40916C',
                            mint: '#D8F3DC',
                            gold: '#D4A373',
                            wheat: '#E9C46A',
                            bg: '#F8F9FA'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Animación sutil para el punto de EN VIVO */
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            80%, 100% { transform: scale(2.2); opacity: 0; }
        }
        .live-dot::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 9999px;
            background-color: #ef4444;
            animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        /* Barra de desplazamiento personalizada */
        ::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-chacra-bg text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Barra Superior Institucional -->
    <header class="bg-chacra-dark text-white shadow-md sticky top-0 z-30 border-b border-chacra-primary/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
            <!-- Logo Chacra TV -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-chacra-light to-chacra-primary flex items-center justify-center shadow-inner border border-chacra-wheat/40">
                    <i data-lucide="sprout" class="w-6 h-6 text-chacra-wheat"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-display font-extrabold text-xl sm:text-2xl tracking-tight text-white">CHACRA<span class="text-chacra-wheat">TV</span></span>
                        <span class="hidden sm:inline-block text-[10px] font-bold uppercase tracking-widest bg-chacra-primary/80 text-chacra-mint px-2 py-0.5 rounded-full border border-chacra-light/30">Señal Agroindustrial</span>
                    </div>
                    <p class="text-xs text-chacra-mint/80 hidden sm:block">El canal del campo y la agroindustria</p>
                </div>
            </div>

            <!-- Reloj en Vivo y Estado de Simulación -->
            <div class="flex items-center gap-3">
                <div id="sim-badge" class="hidden items-center gap-1.5 bg-amber-500/20 border border-amber-400/50 text-amber-200 px-3 py-1 rounded-full text-xs font-semibold">
                    <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-300"></i>
                    <span>Modo Simulación</span>
                </div>
            <!-- Reloj en Vivo -->
            <div class="text-right bg-black/25 px-3.5 py-1.5 rounded-xl border border-white/10">
                <div id="live-clock" class="font-display font-bold text-base sm:text-xl text-chacra-wheat tabular-nums leading-none">--:--:--</div>
                <div id="live-date-label" class="text-[11px] sm:text-xs text-slate-300 capitalize mt-0.5">Cargando...</div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">

        <!-- SECCIÓN 1: TARJETA PRINCIPAL "AHORA EN EMISIÓN" Y "A CONTINUACIÓN" -->
        <section aria-label="Programación en curso" class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
            
            <!-- Tarjeta Principal: En Emisión (8 columnas en desktop) -->
            <div class="lg:col-span-8 bg-gradient-to-br from-chacra-dark via-chacra-primary to-chacra-dark rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden flex flex-col justify-between border border-chacra-light/30">
                <!-- Decoración geométrica de fondo -->
                <div class="absolute -right-12 -top-12 w-56 h-56 rounded-full bg-chacra-wheat/10 blur-2xl pointer-events-none"></div>
                <div class="absolute right-6 bottom-6 opacity-10 pointer-events-none">
                    <i data-lucide="tv" class="w-32 h-32 text-white"></i>
                </div>

                <div>
                    <!-- Badges Superiores -->
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <div class="flex items-center gap-2.5">
                            <span id="status-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600 text-white shadow-sm">
                                <span class="relative flex h-2.5 w-2.5 live-dot">
                                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
                                </span>
                                <span id="status-badge-text">EN VIVO</span>
                            </span>
                            <span id="current-slot-time" class="text-xs sm:text-sm font-semibold bg-white/15 backdrop-blur-sm px-3 py-1 rounded-full text-chacra-wheat border border-white/10">
                                --:-- a --:-- hs
                            </span>
                        </div>
                        <span id="micros-badge" class="hidden items-center gap-1.5 text-xs font-semibold bg-chacra-wheat text-chacra-dark px-3 py-1 rounded-full shadow-sm">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            + Micros CRA
                        </span>
                    </div>

                    <!-- Título del Programa Actual -->
                    <div class="space-y-1.5 my-2">
                        <p id="current-context-label" class="text-xs sm:text-sm font-medium text-chacra-mint/90 uppercase tracking-wider">Ahora en pantalla</p>
                        <h1 id="current-program-title" class="font-display font-extrabold text-2xl sm:text-4xl text-white leading-tight tracking-tight">
                            Cargando programación...
                        </h1>
                        <p id="current-program-subtitle" class="text-sm sm:text-base text-slate-200 max-w-2xl">
                            Consultando la grilla oficial de Chacra TV.
                        </p>
                    </div>
                </div>

                <!-- Barra de Progreso del Bloque -->
                <div id="progress-container" class="mt-6 pt-4 border-t border-white/15">
                    <div class="flex justify-between items-center text-xs font-medium text-chacra-mint mb-2">
                        <span id="progress-elapsed">Transcurrido: 0 min</span>
                        <span id="progress-remaining" class="text-chacra-wheat font-semibold">Restan: -- min</span>
                    </div>
                    <div class="w-full h-2.5 bg-black/35 rounded-full overflow-hidden p-0.5 border border-white/10">
                        <div id="progress-bar" class="h-full bg-gradient-to-r from-chacra-gold to-chacra-wheat rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta Secundaria: A Continuación (4 columnas en desktop) -->
            <div class="lg:col-span-4 bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-chacra-primary bg-chacra-mint/60 px-3 py-1 rounded-full">
                            <i data-lucide="fast-forward" class="w-3.5 h-3.5"></i>
                            A continuación
                        </span>
                        <span id="next-slot-time" class="text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg">
                            --:-- hs
                        </span>
                    </div>

                    <div class="space-y-2">
                        <p id="next-day-label" class="text-xs font-semibold text-chacra-gold uppercase tracking-wide">Próximo bloque</p>
                        <h2 id="next-program-title" class="font-display font-bold text-xl text-slate-900 leading-snug">
                            --
                        </h2>
                        <p id="next-program-detail" class="text-sm text-slate-600">
                            --
                        </p>
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                    <span class="flex items-center gap-1.5">
                        <i data-lucide="calendar-clock" class="w-4 h-4 text-chacra-light"></i>
                        <span id="countdown-next">Inicia en -- min</span>
                    </span>
                    <a href="#grilla-semanal" class="font-semibold text-chacra-primary hover:text-chacra-dark flex items-center gap-1 transition-colors">
                        Ver grilla <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: GRILLA SEMANAL COMPLETA -->
        <section id="grilla-semanal" aria-label="Grilla de programación semanal" class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-chacra-primary">Programación Diaria (07:00 a 20:00 hs)</span>
                    <h2 class="font-display font-extrabold text-xl sm:text-2xl text-slate-900">Grilla Semanal · Lunes a Viernes</h2>
                </div>

                <!-- Filtros rápidos por día (especialmente útiles en móvil/tablet) -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" role="tablist" aria-label="Filtrar grilla por día">
                    <button type="button" data-filter-day="all" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-chacra-dark text-white shadow-sm transition-all cursor-pointer whitespace-nowrap">
                        Todos los días
                    </button>
                    <button type="button" data-filter-day="1" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer">
                        Lunes
                    </button>
                    <button type="button" data-filter-day="2" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer">
                        Martes
                    </button>
                    <button type="button" data-filter-day="3" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer">
                        Miércoles
                    </button>
                    <button type="button" data-filter-day="4" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer">
                        Jueves
                    </button>
                    <button type="button" data-filter-day="5" class="day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer">
                        Viernes
                    </button>
                </div>
            </div>

            <!-- Leyenda de referencias -->
            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 bg-white px-4 py-2.5 rounded-xl border border-slate-200/80">
                <span class="font-semibold text-slate-700">Referencias:</span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span> Emisión EN VIVO
                </span>
                <span class="inline-flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-chacra-gold"></span> Incluye Micros CRA
