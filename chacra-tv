        /**
         * Actualiza toda la interfaz de usuario cada segundo
         */
        function updateUI() {
            const timeObj = getCurrentTime();
            const state = evaluateBroadcastState(timeObj);

            // 1. Actualizar Reloj y Fecha en Header
            const clockEl = document.getElementById('live-clock');
            const dateLabelEl = document.getElementById('live-date-label');
            clockEl.textContent = `${pad2(timeObj.hours)}:${pad2(timeObj.minutes)}:${pad2(timeObj.seconds)}`;
            dateLabelEl.textContent = `${DAY_NAMES[timeObj.dayOfWeek]} · En vivo`;

            // 2. Actualizar Tarjeta Principal ("Ahora en Emisión")
            const statusBadge = document.getElementById('status-badge');
            const statusBadgeText = document.getElementById('status-badge-text');
            const currentSlotTime = document.getElementById('current-slot-time');
            const microsBadge = document.getElementById('micros-badge');
            const contextLabel = document.getElementById('current-context-label');
            const titleEl = document.getElementById('current-program-title');
            const subtitleEl = document.getElementById('current-program-subtitle');
            const progressContainer = document.getElementById('progress-container');
            const progressBar = document.getElementById('progress-bar');
            const progressElapsed = document.getElementById('progress-elapsed');
            const progressRemaining = document.getElementById('progress-remaining');

            if (state.isOnAir) {
                const prog = state.program;
                contextLabel.textContent = `Ahora en pantalla · ${DAY_NAMES[state.dayOfWeek]}`;
                titleEl.textContent = formatProgramFullName(prog);
                subtitleEl.textContent = prog.subtitle;
                currentSlotTime.textContent = `${state.slot.start} a ${state.slot.end} hs`;

                // Badge EN VIVO vs AL AIRE
                if (prog.isLive) {
                    statusBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600 text-white shadow-sm';
                    statusBadgeText.textContent = 'EN VIVO';
                } else {
                    statusBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white shadow-sm';
                    statusBadgeText.textContent = 'EN EMISIÓN';
                }

                // Badge Micros CRA
                if (prog.hasMicrosCRA) {
                    microsBadge.classList.remove('hidden');
                    microsBadge.classList.add('inline-flex');
                } else {
                    microsBadge.classList.add('hidden');
                    microsBadge.classList.remove('inline-flex');
                }

                // Barra de progreso
                progressContainer.classList.remove('hidden');
                progressBar.style.width = `${state.progressPercent.toFixed(1)}%`;
                progressElapsed.textContent = `Transcurrido: ${state.elapsedMin} min`;
                progressRemaining.textContent = `Restan: ${state.remainingMin} min`;

            } else {
                // Fuera de franja habitual o fin de semana
                statusBadge.className = 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-700/90 text-slate-200 border border-white/15';
                statusBadgeText.textContent = 'PROGRAMACIÓN CONTINUA';
                currentSlotTime.textContent = 'Grilla Habitual: 07:00 a 20:00 hs';
                microsBadge.classList.add('hidden');
                microsBadge.classList.remove('inline-flex');
                progressContainer.classList.add('hidden');

                if (state.reason === 'weekend') {
                    contextLabel.textContent = `Fin de semana · ${DAY_NAMES[state.dayOfWeek]}`;
                    titleEl.textContent = 'Edición Especial de Fin de Semana';
                    subtitleEl.textContent = `La grilla habitual de Chacra TV retoma el ${state.next.dayLabel} a las ${state.next.timeLabel} con ${formatProgramFullName(state.next.program)}.`;
                } else if (state.reason === 'before_hours') {
                    contextLabel.textContent = `Madrugada · ${DAY_NAMES[state.dayOfWeek]}`;
                    titleEl.textContent = 'Apertura de Transmisión a las 07:00 hs';
                    subtitleEl.textContent = `En instantes comienza la programación diaria de Chacra TV con ${formatProgramFullName(state.next.program)}.`;
                } else {
                    contextLabel.textContent = `Cierre de grilla diaria · ${DAY_NAMES[state.dayOfWeek]}`;
                    titleEl.textContent = 'Programación Especial Nocturna';
                    subtitleEl.textContent = `La grilla habitual vuelve ${state.next.dayLabel.toLowerCase()} a las ${state.next.timeLabel} con ${formatProgramFullName(state.next.program)}.`;
                }
            }

            // 3. Actualizar Tarjeta Secundaria ("A Continuación")
            if (state.next) {
                document.getElementById('next-day-label').textContent = state.next.dayLabel;
                document.getElementById('next-slot-time').textContent = state.next.timeLabel;
                document.getElementById('next-program-title').textContent = formatProgramFullName(state.next.program);
                document.getElementById('next-program-detail').textContent = state.next.program.subtitle;
                document.getElementById('countdown-next').textContent = state.next.countdownText;
            }

            // 4. Resaltar Columna del Día y Celda Activa en la Tabla
            const activeDay = (timeObj.dayOfWeek >= 1 && timeObj.dayOfWeek <= 5) ? timeObj.dayOfWeek : null;
            const activeSlotId = state.isOnAir ? state.slot.id : null;

            // Encabezados de días
            document.querySelectorAll('th[data-col-day]').forEach(th => {
                const colDay = parseInt(th.getAttribute('data-col-day'), 10);
                const todayTag = th.querySelector('.day-today-tag');
                if (colDay === activeDay) {
                    th.classList.add('bg-chacra-primary', 'text-chacra-wheat');
                    todayTag.classList.remove('hidden');
                } else {
                    th.classList.remove('bg-chacra-primary', 'text-chacra-wheat');
                    todayTag.classList.add('hidden');
                }
            });

            // Celdas de la tabla
            document.querySelectorAll('td[data-cell-key]').forEach(td => {
                const cellKey = td.getAttribute('data-cell-key');
                const cellDay = parseInt(td.getAttribute('data-cell-day'), 10);
                const indicator = td.querySelector('.now-playing-indicator');

                const isCurrentCell = activeDay && activeSlotId && cellKey === `${activeDay}-${activeSlotId}`;

                if (isCurrentCell) {
                    td.classList.add('bg-chacra-mint/70', 'ring-2', 'ring-inset', 'ring-chacra-primary');
                    td.classList.remove('bg-chacra-mint/15');
                    indicator.classList.remove('hidden');
                    indicator.classList.add('inline-flex');
                } else if (cellDay === activeDay) {
                    td.classList.add('bg-chacra-mint/15');
                    td.classList.remove('bg-chacra-mint/70', 'ring-2', 'ring-inset', 'ring-chacra-primary');
                    indicator.classList.add('hidden');
                    indicator.classList.remove('inline-flex');
                } else {
                    td.classList.remove('bg-chacra-mint/70', 'bg-chacra-mint/15', 'ring-2', 'ring-inset', 'ring-chacra-primary');
                    indicator.classList.add('hidden');
                    indicator.classList.remove('inline-flex');
                }
            });

            // 5. Si está activo el filtro de un solo día en móvil/desktop, actualizar sus tarjetas
            if (appState.selectedFilterDay !== 'all') {
                const filterDayNum = parseInt(appState.selectedFilterDay, 10);
                renderSingleDayCards(filterDayNum, filterDayNum === activeDay ? activeSlotId : null);
            }
        }

        /**
         * Inicialización de los filtros por día
         */
        function initControls() {
            const filterBtns = document.querySelectorAll('.day-filter-btn');
            const desktopWrapper = document.getElementById('desktop-grid-wrapper');
            const singleDayWrapper = document.getElementById('single-day-cards-wrapper');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const selectedDay = btn.getAttribute('data-filter-day');
                    appState.selectedFilterDay = selectedDay;

                    // Actualizar estilos de botones
                    filterBtns.forEach(b => {
                        b.className = 'day-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 transition-all cursor-pointer whitespace-nowrap';
                    });
                    btn.className = 'day-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-chacra-dark text-white shadow-sm transition-all cursor-pointer whitespace-nowrap';

                    if (selectedDay === 'all') {
                        desktopWrapper.classList.remove('hidden');
                        singleDayWrapper.classList.add('hidden');
                    } else {
                        desktopWrapper.classList.add('hidden');
                        singleDayWrapper.classList.remove('hidden');
                    }

                    updateUI();
                });
            });
        }

        // Arranque al cargar la ventana
        window.addEventListener('DOMContentLoaded', () => {
            renderScheduleTable();
            initControls();
            updateUI();

            // Iconos Lucide
            if (window.lucide) {
                lucide.createIcons();
            }

            // Actualizar cada segundo
            setInterval(updateUI, 1000);
        });
    </script>
</body>
</html>
