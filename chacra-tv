                <span class="inline-flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded bg-chacra-mint border border-chacra-light"></span> Programa al aire ahora
                </span>
            </div>

            <!-- Contenedor de la Tabla Responsiva (Vista Desktop y Tablet) -->
            <div id="desktop-grid-wrapper" class="bg-white rounded-2xl shadow-md border border-slate-200/90 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[780px]">
                        <thead>
                            <tr class="bg-chacra-dark text-white text-xs uppercase tracking-wider">
                                <th class="py-4 px-4 font-display font-bold w-28 border-r border-white/10 sticky left-0 bg-chacra-dark z-10">
                                    Horario
                                </th>
                                <th data-col-day="1" class="py-4 px-4 font-display font-bold w-1/5 border-r border-white/10 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <span>Lunes</span>
                                        <span class="day-today-tag hidden text-[10px] bg-chacra-wheat text-chacra-dark px-2 py-0.5 rounded-full font-extrabold">HOY</span>
                                    </div>
                                </th>
                                <th data-col-day="2" class="py-4 px-4 font-display font-bold w-1/5 border-r border-white/10 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <span>Martes</span>
                                        <span class="day-today-tag hidden text-[10px] bg-chacra-wheat text-chacra-dark px-2 py-0.5 rounded-full font-extrabold">HOY</span>
                                    </div>
                                </th>
                                <th data-col-day="3" class="py-4 px-4 font-display font-bold w-1/5 border-r border-white/10 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <span>Miércoles</span>
                                        <span class="day-today-tag hidden text-[10px] bg-chacra-wheat text-chacra-dark px-2 py-0.5 rounded-full font-extrabold">HOY</span>
                                    </div>
                                </th>
                                <th data-col-day="4" class="py-4 px-4 font-display font-bold w-1/5 border-r border-white/10 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <span>Jueves</span>
                                        <span class="day-today-tag hidden text-[10px] bg-chacra-wheat text-chacra-dark px-2 py-0.5 rounded-full font-extrabold">HOY</span>
                                    </div>
                                </th>
                                <th data-col-day="5" class="py-4 px-4 font-display font-bold w-1/5 transition-colors">
                                    <div class="flex items-center justify-between">
                                        <span>Viernes</span>
                                        <span class="day-today-tag hidden text-[10px] bg-chacra-wheat text-chacra-dark px-2 py-0.5 rounded-full font-extrabold">HOY</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="schedule-table-body" class="divide-y divide-slate-200/80 text-sm">
                            <!-- Filas generadas dinámicamente por JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Vista de Tarjetas por Día (Se muestra cuando se filtra un día específico) -->
            <div id="single-day-cards-wrapper" class="hidden space-y-3">
                <!-- Tarjetas generadas dinámicamente cuando el usuario selecciona un día en el filtro -->
            </div>
        </section>

    </main>

    <!-- Footer Institucional -->
    <footer class="bg-chacra-dark text-slate-300 border-t border-chacra-primary/40 mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
            <div class="flex items-center gap-2">
                <span class="font-display font-bold text-white text-sm">CHACRA<span class="text-chacra-wheat">TV</span></span>
                <span class="text-slate-400">|</span>
                <span>Grilla de Programación Oficial · Horario de Argentina (GMT-3)</span>
            </div>
            <p class="text-slate-400">Actualización automática en tiempo real.</p>
        </div>
    </footer>

