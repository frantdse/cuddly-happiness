        /**
         * Obtiene el objeto de tiempo actual del dispositivo
         */
        function getCurrentTime() {
            const now = new Date();
            return {
                dayOfWeek: now.getDay(), // 0 = Domingo, 1 = Lunes ... 6 = Sábado
                hours: now.getHours(),
                minutes: now.getMinutes(),
                seconds: now.getSeconds(),
                totalMinutes: now.getHours() * 60 + now.getMinutes()
            };
        }

        /**
         * Formatea números a dos dígitos (ej. 9 -> "09")
         */
        function pad2(num) {
            return String(num).padStart(2, '0');
        }

        /**
         * Devuelve el nombre completo del programa incluyendo su edición si existe
         */
        function formatProgramFullName(prog) {
            return prog.edition ? `${prog.title} (${prog.edition})` : prog.title;
        }

        /**
         * Evalúa qué programa está al aire y cuál sigue según el día y hora actual
         */
        function evaluateBroadcastState(timeObj) {
            const { dayOfWeek, totalMinutes } = timeObj;

            // Fin de semana (Sábado = 6, Domingo = 0)
            if (dayOfWeek === 0 || dayOfWeek === 6) {
                const firstSlot = SCHEDULE_SLOTS[0];
                return {
                    isOnAir: false,
                    reason: 'weekend',
                    dayOfWeek,
                    next: {
                        dayLabel: 'Lunes',
                        timeLabel: `${firstSlot.start} hs`,
                        program: firstSlot.days[1],
                        countdownText: `Retoma el lunes a las ${firstSlot.start} hs`
                    }
                };
            }

            // Buscar si hay un bloque activo ahora
            const currentSlot = SCHEDULE_SLOTS.find(s => totalMinutes >= s.startMin && totalMinutes < s.endMin);

            if (currentSlot) {
                const prog = currentSlot.days[dayOfWeek];
                const durationMin = currentSlot.endMin - currentSlot.startMin;
                const elapsedMin = totalMinutes - currentSlot.startMin;
                const remainingMin = Math.max(1, currentSlot.endMin - totalMinutes);
                const progressPercent = Math.min(100, Math.max(0, (elapsedMin / durationMin) * 100));

                // Calcular siguiente bloque
                const currentIndex = SCHEDULE_SLOTS.indexOf(currentSlot);
                let nextInfo = null;

                if (currentIndex < SCHEDULE_SLOTS.length - 1) {
                    const nextSlot = SCHEDULE_SLOTS[currentIndex + 1];
                    nextInfo = {
                        dayLabel: `Hoy · ${DAY_NAMES[dayOfWeek]}`,
                        timeLabel: `${nextSlot.start} hs`,
                        program: nextSlot.days[dayOfWeek],
                        countdownText: `Inicia en ${remainingMin} min`
                    };
                } else {
                    const nextDay = dayOfWeek === 5 ? 1 : dayOfWeek + 1;
                    const firstSlot = SCHEDULE_SLOTS[0];
                    nextInfo = {
                        dayLabel: dayOfWeek === 5 ? 'Lunes' : `Mañana · ${DAY_NAMES[nextDay]}`,
                        timeLabel: `${firstSlot.start} hs`,
                        program: firstSlot.days[nextDay],
                        countdownText: `Próxima apertura: ${firstSlot.start} hs`
                    };
                }

                return {
                    isOnAir: true,
                    dayOfWeek,
                    slot: currentSlot,
                    program: prog,
                    elapsedMin,
                    remainingMin,
                    progressPercent,
                    next: nextInfo
                };
            }

            // Antes de las 07:00 hs
            if (totalMinutes < SCHEDULE_SLOTS[0].startMin) {
                const firstSlot = SCHEDULE_SLOTS[0];
                const diffMin = firstSlot.startMin - totalMinutes;
                return {
                    isOnAir: false,
                    reason: 'before_hours',
                    dayOfWeek,
                    next: {
                        dayLabel: `Hoy · ${DAY_NAMES[dayOfWeek]}`,
                        timeLabel: `${firstSlot.start} hs`,
                        program: firstSlot.days[dayOfWeek],
                        countdownText: diffMin <= 60 ? `Inicia en ${diffMin} min` : `Inicia a las ${firstSlot.start} hs`
                    }
                };
            }

            // Después de las 20:00 hs
            const nextDay = dayOfWeek === 5 ? 1 : dayOfWeek + 1;
            const firstSlot = SCHEDULE_SLOTS[0];
            return {
                isOnAir: false,
                reason: 'after_hours',
                dayOfWeek,
                next: {
                    dayLabel: dayOfWeek === 5 ? 'Lunes' : `Mañana · ${DAY_NAMES[nextDay]}`,
                    timeLabel: `${firstSlot.start} hs`,
                    program: firstSlot.days[nextDay],
                    countdownText: `Apertura a las ${firstSlot.start} hs`
                }
            };
        }

